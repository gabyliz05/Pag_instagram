<%= image_tag(@post.image.url(:large)) %>
<br>
<%= @post.description %>

<% if current_user && current_user == @post.user %>
  <div class="link">
    <%= link_to "Destroy", @post, method: :delete, data: { confirm: "Are you sure?" } %>
    <%= link_to "Edit", edit_post_path(@post) %>
  </div>
<% end %>
